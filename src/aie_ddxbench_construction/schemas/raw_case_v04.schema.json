{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/aie-ddxbench/raw-case-v04.schema.json",
  "title": "AIE-DDxBench raw case v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "version", "track", "public_input", "hidden_reference"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^AIE_DDX_[A-Z0-9_]+$"},
    "version": {"const": "0.4"},
    "track": {"const": "reference-alignment"},
    "public_input": {"$ref": "#/$defs/publicInput"},
    "hidden_reference": {"$ref": "#/$defs/hiddenReference"}
  },
  "$defs": {
    "publicInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["molecule", "task"],
      "properties": {
        "molecule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure"],
          "properties": {
            "structure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "value"],
              "properties": {
                "format": {"const": "smiles"},
                "value": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "task": {"type": "string", "minLength": 1}
      }
    },
    "hiddenReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_article", "reference_evidence_units", "reference_diagnosis_units"],
      "properties": {
        "source_article": {"$ref": "#/$defs/sourceArticle"},
        "reference_evidence_units": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceUnit"}
        },
        "reference_diagnosis_units": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/diagnosisUnit"}
        }
      }
    },
    "sourceArticle": {
      "type": "object",
      "required": ["candidate_id", "doi"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "article_title": {"type": ["string", "null"]},
        "molecule_label": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "evidenceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim",
        "mechanistic_interpretation",
        "mechanism_links",
        "evidence_accessibility",
        "source_span",
        "paper_quote"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^[EN][0-9]+$"},
        "claim": {"type": "string", "minLength": 1},
        "mechanistic_interpretation": {"type": "string", "minLength": 1},
        "mechanism_links": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/officialMechanism"}
        },
        "evidence_accessibility": {"type": "string", "minLength": 1},
        "source_span": {"type": "string", "minLength": 1},
        "paper_quote": {"type": "string", "minLength": 1}
      }
    },
    "diagnosisUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id",
        "mechanism",
        "context",
        "reference_status",
        "expert_conclusion",
        "supporting_evidence_ids",
        "diagnosis_role"
      ],
      "properties": {
        "diagnosis_id": {"type": "string", "pattern": "^D[0-9]{2}$"},
        "mechanism": {"$ref": "#/$defs/diagnosisMechanism"},
        "context": {"type": "string", "minLength": 1},
        "reference_status": {
          "enum": ["supported", "weakened_or_rejected", "underdetermined"]
        },
        "expert_conclusion": {"type": "string", "minLength": 1},
        "supporting_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[EN][0-9]+$"}
        },
        "diagnosis_role": {"type": "string", "minLength": 1}
      }
    },
    "officialMechanism": {
      "enum": [
        "AGGREGATE_EXCITON_EXCIMER",
        "ESIPT_PT",
        "HOST_GUEST_INTERACTION",
        "ICT_TICT_CT",
        "PACKING_HOST_MATRIX_CONFINEMENT",
        "PET_ET",
        "RACI_CI_ACCESS",
        "RADIATIVE_RATE_STATE_BALANCE",
        "RIM_RIR_RIV",
        "SOKR_ANTI_KASHA",
        "TRIPLET_METAL_ENERGY_TRANSFER"
      ]
    },
    "diagnosisMechanism": {
      "enum": [
        "AGGREGATE_EXCITON_EXCIMER",
        "ESIPT_PT",
        "HOST_GUEST_INTERACTION",
        "ICT_TICT_CT",
        "PACKING_HOST_MATRIX_CONFINEMENT",
        "PET_ET",
        "RACI_CI_ACCESS",
        "RADIATIVE_RATE_STATE_BALANCE",
        "RIM_RIR_RIV",
        "SOKR_ANTI_KASHA",
        "TRIPLET_METAL_ENERGY_TRANSFER",
        "FINAL_EVIDENCE_GROUNDED_DIAGNOSIS"
      ]
    }
  }
}
